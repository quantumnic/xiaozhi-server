# Required: OpenAI API key (needed for Whisper STT and TTS)
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Anthropic API key (only if using Claude as LLM)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM Provider: "openai" or "anthropic" (default: openai)
LLM_PROVIDER=openai

# LLM Model (default: auto-selected based on provider)
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-sonnet-4-20250514

# Whisper model (default: whisper-1)
# WHISPER_MODEL=whisper-1

# TTS voice: alloy, echo, fable, onyx, nova, shimmer (default: alloy)
# TTS_VOICE=alloy

# TTS model (default: tts-1, or tts-1-hd for higher quality)
# TTS_MODEL=tts-1

# Server bind address and port
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8765

# Optional: Bearer token for ESP32 auth
# AUTH_TOKEN=my-secret-token

# System prompt for the LLM
# SYSTEM_PROMPT=Du bist ein hilfreicher Assistent. Antworte kurz und prägnant.

# Max conversation history messages to keep (default: 10)
# MAX_HISTORY=10
